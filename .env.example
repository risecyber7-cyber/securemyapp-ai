NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

SECUREMYAPP_ENVIRONMENT=development
SECUREMYAPP_SECRET_KEY=change-me-in-production
SECUREMYAPP_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/securemyapp
SECUREMYAPP_REDIS_URL=redis://localhost:6379/0
SECUREMYAPP_BROKER_URL=redis://localhost:6379/1
SECUREMYAPP_RESULT_BACKEND=redis://localhost:6379/2
SECUREMYAPP_ALLOW_DEMO_AUTH=true
SECUREMYAPP_SEED_DEMO_DATA=true
SECUREMYAPP_OPENROUTER_API_KEY=
SECUREMYAPP_OPENROUTER_MODEL=openai/gpt-4.1-mini
SECUREMYAPP_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
SECUREMYAPP_OPENROUTER_TIMEOUT_SECONDS=20
